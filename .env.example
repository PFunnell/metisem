# Environment configuration for obsidian-linker

# Ollama host for summariser (default: localhost:11434)
# OLLAMA_HOST=localhost:11434

# Test vault for scripts/test_run_logging.py. Integration tests (pytest) read
# TEST_VAULT_PATH from the process environment, so set it there as well.
# TEST_VAULT_PATH=D:\path\to\test-vault
